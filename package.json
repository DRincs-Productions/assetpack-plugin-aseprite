{
  "name": "@drincs/assetpack-plugin-aseprite",
  "description": "AssetPack plugin to convert Aseprite and LibreSprite files into PixiJS spritesheets at build time",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    "playground"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup --config tsup.config.ts",
    "lint": "biome lint",
    "check": "biome check",
    "format": "biome format --write",
    "test": "vitest",
    "test:cdn": "npm run build && node scripts/test-pencode-local.mjs",
    "docs": "typedoc",
    "playground:install": "npm ci -w playground",
    "playground:dev": "npm run build && npm run dev -w playground",
    "playground:preview": "npm run build && npm run build -w playground && npm run preview -w playground",
    "skills:validate": "node scripts/validate-skills.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/index.mjs"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "jsdom": "^27.4.0",
    "ts-node": "^10.9.2",
    "tsup": "^9.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.5"
  },
  "peerDependencies": {
    "@drincs/pixi-vn": ">=1.9.0"
  },
  "keywords": [
    "game",
    "js",
    "novel",
    "pixi",
    "pixi-vn",
    "visual",
    "visual-novel"
  ]
}
